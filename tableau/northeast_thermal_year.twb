            <column caption="Label" datatype='string' name='[label]' role='dimension' type='nominal' />
            <column caption="Basis matches" datatype='boolean' name='[Calculation_basis_match]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="[basis] = [Parameters].[Parameter 2]" />
            </column>
            <column caption="Top 12" datatype='boolean' name='[Calculation_top_12]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year_round_rank] &lt;= 12" />
            </column>
            <column caption="Quadrant color code" datatype='integer' name='[Calculation_quadrant_code]' role='measure' type='quantitative'>
              <calculation class='tableau' formula="CASE [quadrant] WHEN 'Low demand' THEN 1 WHEN 'Summer only' THEN 2 WHEN 'Winter only' THEN 3 ELSE 4 END" />
            </column>
            <column caption="Score (0-100)" datatype='string' name='[Calculation_score_100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="STR(INT(ROUND([year_round_score] * 100, 0)))" />
            </column>
            <column caption="County" datatype='string' name='[Calculation_county_label]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="REPLACE(REPLACE([county_name], ' Planning Region', ''), ' County', '') + ', ' + [state_abbr]" />
            </column>
