        <zone h='12800' id='12' w='40000' x='60000' y='61400' type-v2='text'>
            <formatted-text>
              <run fontcolor='#E0662B' fontname='Tableau Semibold' fontsize='10'>QUADRANT</run>
              <run>Æ&#10;</run>
              <run fontcolor='#F2C14E' fontname='Tableau Book' fontsize='13'>■ </run>
              <run fontcolor='#E8E6E1' fontname='Tableau Book' fontsize='11'>Year-round   </run>
              <run fontcolor='#E0662B' fontname='Tableau Book' fontsize='13'>■ </run>
              <run fontcolor='#E8E6E1' fontname='Tableau Book' fontsize='11'>Winter only   </run>
              <run fontcolor='#5FB4E8' fontname='Tableau Book' fontsize='13'>■ </run>
              <run fontcolor='#E8E6E1' fontname='Tableau Book' fontsize='11'>Summer only   </run>
              <run fontcolor='#3A4659' fontname='Tableau Book' fontsize='13'>■ </run>
              <run fontcolor='#E8E6E1' fontname='Tableau Book' fontsize='11'>Low demand</run>
              <run>Æ&#10;</run>
              <run fontcolor='#8B95A7' fontname='Tableau Book' fontsize='10'>Split at the 50th percentile on each axis. Bubble size = homes.</run>
            </formatted-text>
          <zone-style>
