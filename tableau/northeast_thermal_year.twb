    <worksheet name="Top Markets">
      <table>
        <view>
          <datasources>
            <datasource caption="County scores" name='federated.scores0thermal0year00000001' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;January 2026&quot;'>
              <calculation class='tableau' formula='&quot;January 2026&quot;' />
              <members>
                <member value='&quot;July 2025&quot;' />
                <member value='&quot;August 2025&quot;' />
                <member value='&quot;September 2025&quot;' />
                <member value='&quot;October 2025&quot;' />
                <member value='&quot;November 2025&quot;' />
                <member value='&quot;December 2025&quot;' />
                <member value='&quot;January 2026&quot;' />
                <member value='&quot;February 2026&quot;' />
                <member value='&quot;March 2026&quot;' />
                <member value='&quot;April 2026&quot;' />
                <member value='&quot;May 2026&quot;' />
                <member value='&quot;June 2026&quot;' />
              </members>
            </column>
            <column caption='Rank counties by' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
              <members>
                <member value='&quot;Total&quot;' />
                <member value='&quot;Per home&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.scores0thermal0year00000001'>
            <column caption="County Key" datatype='string' name='[county_key]' role='dimension' type='nominal' />
            <column caption="Heating Percentile" datatype='real' name='[heating_pct]' role='measure' type='quantitative' />
            <column caption="Cooling Percentile" datatype='real' name='[cooling_pct]' role='measure' type='quantitative' />
            <column caption="Year-Round Score" datatype='real' name='[year_round_score]' role='measure' type='quantitative' />
            <column caption="Homes" datatype='integer' name='[total_occupied]' role='measure' type='quantitative' />
            <column caption="Heating Spend" datatype='real' name='[heating_spend]' role='measure' type='quantitative' />
            <column caption="Oil + Propane Share" datatype='real' name='[oil_propane_share]' role='measure' type='quantitative' />
            <column caption="Quadrant" datatype='string' name='[quadrant]' role='dimension' type='nominal' />
            <column caption="Label" datatype='string' name='[label]' role='dimension' type='nominal' />
            <column caption="Basis matches" datatype='boolean' name='[Calculation_basis_match]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="[basis] = [Parameters].[Parameter 2]" />
            </column>
            <column caption="Top 12" datatype='boolean' name='[Calculation_top_12]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year_round_rank] &lt;= 12" />
            </column>
            <column caption="Quadrant color code" datatype='integer' name='[Calculation_quadrant_code]' role='measure' type='quantitative'>
              <calculation class='tableau' formula="CASE [quadrant] WHEN 'Low demand' THEN 1 WHEN 'Summer only' THEN 2 WHEN 'Winter only' THEN 3 ELSE 4 END" />
            </column>
            <column caption="Score (0-100)" datatype='string' name='[Calculation_score_100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="STR(INT(ROUND([year_round_score] * 100, 0)))" />
            </column>
            <column caption="County" datatype='string' name='[Calculation_county_label]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="REPLACE(REPLACE([county_name], ' Planning Region', ''), ' County', '') + ', ' + [state_abbr]" />
            </column>
            <column caption="Basis" datatype='string' name='[basis]' role='dimension' type='nominal' />
            <column caption="Year-Round Rank" datatype='integer' name='[year_round_rank]' role='measure' type='quantitative' />
            <column caption="County Name" datatype='string' name='[county_name]' role='dimension' type='nominal' />
            <column caption="State" datatype='string' name='[state_abbr]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_county_label]' derivation='None' name='[none:Calculation_county_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_county_label]' derivation='Attribute' name='[attr:Calculation_county_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[year_round_score]' derivation='Sum' name='[sum:year_round_score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[heating_spend]' derivation='Sum' name='[sum:heating_spend:qk]' pivot='key' type='quantitative' />
            <column-instance column='[oil_propane_share]' derivation='Sum' name='[sum:oil_propane_share:qk]' pivot='key' type='quantitative' />
            <column-instance column='[quadrant]' derivation='Attribute' name='[attr:quadrant:nk]' pivot='key' type='nominal' />
            <column-instance column='[quadrant]' derivation='None' name='[none:quadrant:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_quadrant_code]' derivation='Avg' name='[avg:Calculation_quadrant_code:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_score_100]' derivation='Attribute' name='[attr:Calculation_score_100:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_basis_match]' derivation='None' name='[none:Calculation_basis_match:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_top_12]' derivation='None' name='[none:Calculation_top_12:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
        <filter class='categorical' column='[federated.scores0thermal0year00000001].[none:Calculation_basis_match:nk]'>
          <groupfilter function='member' level='[none:Calculation_basis_match:nk]' member="true" user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
        </filter>
        <filter class='categorical' column='[federated.scores0thermal0year00000001].[none:Calculation_top_12:nk]'>
          <groupfilter function='member' level='[none:Calculation_top_12:nk]' member="true" user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
        </filter>
          <sort class='computed' column='[federated.scores0thermal0year00000001].[none:Calculation_county_label:nk]' direction='DESC' using='[federated.scores0thermal0year00000001].[sum:year_round_score:qk]' />
          <slices>
            <column>[federated.scores0thermal0year00000001].[none:Calculation_basis_match:nk]</column>
            <column>[federated.scores0thermal0year00000001].[none:Calculation_top_12:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'>
            <format attr='background-color' value='#0B1220' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#8B95A7' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='dropline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='line-visibility' scope='rows' value='off' />
            <format attr='line-visibility' scope='cols' value='off' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#0B1220' />
          </style-rule>
