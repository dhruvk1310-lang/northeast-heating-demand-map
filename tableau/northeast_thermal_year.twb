    <dashboard name="Where the Year-Round Money Is">
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#0B1220' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='100000' id='3' w='100000' x='0' y='0' param='vert' type-v2='layout-flow'>
